# Build and install liburing only if its source changed. All the build trees share one
# install, so the stamp is kept with it and not in a build tree. The stamp is a hash of
# the contents of the source: a new mtime or file mode alone is not a change.
#
# cmake -DSRC=<source dir> -DPREFIX=<install dir> -P liburing-build.cmake

file(MAKE_DIRECTORY "${PREFIX}")

# Build trees may run at the same time.
file(LOCK "${PREFIX}/.lock" GUARD PROCESS TIMEOUT 600)

file(GLOB_RECURSE sources RELATIVE "${SRC}" "${SRC}/src/*.c" "${SRC}/src/*.h" "${SRC}/src/*.S" "${SRC}/src/*.map")

# Generated by its configure and its make.
list(FILTER sources EXCLUDE REGEX "(^|/)(compat|io_uring_version)\\.h$")

list(APPEND sources Makefile Makefile.common Makefile.quiet configure src/Makefile)
list(REMOVE_DUPLICATES sources)
list(SORT sources)

set(all "")

foreach(f IN LISTS sources)
  if(EXISTS "${SRC}/${f}")
    file(SHA256 "${SRC}/${f}" h)
    string(APPEND all "${f} ${h}\n")
  endif()
endforeach()

string(SHA256 sum "${all}")

set(stamp "${PREFIX}/.source-stamp")
set(old "")

if(EXISTS "${stamp}")
  file(READ "${stamp}" old)
endif()

if(old STREQUAL sum AND EXISTS "${PREFIX}/lib/liburing.a")
  return()
endif()

message(STATUS "liburing: the source changed, building")

# From clean: what the last configure generated is for the old source. Only the library,
# not its tests and examples.
execute_process(COMMAND make -C "${SRC}" clean COMMAND_ERROR_IS_FATAL ANY)

execute_process(
  COMMAND sh ./configure
    "--prefix=${PREFIX}"
    "--includedir=${PREFIX}/include"
    "--libdir=${PREFIX}/lib"
    "--libdevdir=${PREFIX}/lib"
    "--mandir=${PREFIX}/man"
  WORKING_DIRECTORY "${SRC}"
  COMMAND_ERROR_IS_FATAL ANY
)

execute_process(COMMAND make -C "${SRC}" library COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND make -C "${SRC}" install COMMAND_ERROR_IS_FATAL ANY)

# Last: a failed build is tried again.
file(WRITE "${stamp}" "${sum}")
